# ===========================================================================
# SAFE TEMPLATE - copy to .env.local and fill in. NEVER put a real value here.
#
#   cp .env.example .env.local
#
# .env.local is the operator's LOCAL SOURCE OF TRUTH and is git-ignored.
# Precedence:  .env.local  >  process environment  >  built-in default
#
# Check what is actually loaded (names only, never values):
#   python -m autopaper.cli config-source
#
# There is deliberately NO REAL_TRADING_ENABLED switch you can set here to arm
# live trading. REAL is armed only by a confirmed Telegram operator action plus
# a passing preflight. The value below is recorded and REPORTED as ignored.
# ===========================================================================

# --- STRATEGY PROFILE -------------------------------------------------------
# Selects the EXIT-policy variant. It does NOT select the entry strategy: every
# profile trades the same L25 entry, unchanged.
#
#   L25_CURRENT  (default) L25 entry + the existing exit rules, exactly as
#                            before profiles existed. No maximum hold.
#   L25_60S                 The same L25 entry and the same existing exit rules,
#                            PLUS a 60s maximum hold. An existing stop,
#                            momentum, structure, dead-thesis or disaster exit
#                            that fires first still wins.
#
# An unrecognised value is REFUSED at startup rather than defaulted, so a typo
# cannot leave the bot trading a profile nobody selected.
#
# The operator can also switch this from the Telegram menu
# (STRATEGY -> profile) at any time, including while the bot is stopped. That
# selection applies to positions opened AFTER the change; a position already
# open keeps the profile it was opened under. Selecting a profile never starts
# the bot, never arms REAL and never broadcasts.
#
# L25_60S comes from a RETROSPECTIVE replay
# (reports/research/l25_60s_backtest.md): win rate 56.90% -> 78.45%, max DD
# -12.71% -> -5.86%, PF 6.53 -> 9.51, but ending bankroll $2,027 -> $1,977 on a
# $10 account, and chronological consistency was MIXED (negative on TRAIN and on
# TEST). It is NOT proven superior and must be validated prospectively. That is
# why L25_CURRENT is the default.
STRATEGY_PROFILE=L25_CURRENT

# --- Telegram: reading the candidate feed ---------------------------------
# A Telegram USER session (MTProto), used to read Moo Deng President.
# Get api_id/api_hash from https://my.telegram.org, then run
# `python -m autopaper.cli login` once to create TELEGRAM_SESSION.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHAT=

# Created by `autopaper cli login`. Paste the printed string here.
# TELEGRAM_SESSION=

# false = new messages only. true replays history, which can produce
# catch-up decisions. Keep false unless you specifically want a replay.
TELEGRAM_ALLOW_BACKLOG=false

# --- Telegram: operator control + notification (Bot API) -----------------
# BOTH are required. With a token but no chat there is nothing to allow-list,
# and the control channel stays INACTIVE rather than admitting every chat.
#
# TELEGRAM_BOT_CHAT is the authorization boundary: an update is dispatched only
# when its numeric chat id equals this one. It is compared as an INTEGER, so a
# username or a padded string cannot impersonate it. The bot must be a member of
# that chat to post.
#
# NEVER commit a real token. This file is the template; the real values live in
# .env.local, which is git-ignored.
#
# The token is a bearer credential (it appears in the Bot API URL), so it is
# never logged, never included in an exception, and never shown by
# `telegram-status` - which reports booleans only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_CHAT=

# --- Narrative / Phanes (OPTIONAL feature input, never a candidate source) -
NAR_ENABLED=true
NAR_BOT=Phanes_bot
NAR_COMMAND=/nar
# NAR_API_KEY=
# NAR_BASE_URL=

# --- Market data (DexScreener primary, GeckoTerminal fallback) -------------
MARKET_POLL_INTERVAL_S=5
MARKET_OPEN_POLL_INTERVAL_S=3
MARKET_ALERT_SETTLE_S=2
MARKET_STALE_AFTER_MS=15000
MARKET_UNUSABLE_AFTER_MS=45000
MARKET_MAX_RPM=110

# --- NATIVE MARKET MONITORING (event-driven, pushes instead of polling) ----
#
# WITHOUT THIS the runtime monitors every open position by POLLING the RPC
# (getSlot + getMultipleAccounts + getTokenSupply per position per tick). That
# is the polling recovery path: correct, but it spends the shared request budget
# on reads that a subscription would make unnecessary, and a budget that is
# spent is exactly what surfaces as "market data unusable for 123s".
#
# WITH IT, open positions are monitored from pushed Solana account updates with
# a LOCAL price calculation: zero RPC and zero HTTP per tick. An executable
# SELL quote is still requested when an existing exit condition is near.
#
# The endpoint MUST be a wss:// (or local-only ws://) URL. An HTTP RPC URL is
# REFUSED with a diagnostic rather than converted: the HTTP and PubSub services
# are separate, and an endpoint that does not serve websockets must not silently
# become a monitor that never connects.
#
# Leave it empty to stay on the polling path; that is a valid configuration,
# not an error. Verify an endpoint before trusting it:
#   PYTHONPATH=src python scripts/native_monitor_ws_probe.py --url wss://... --mode slot
#
# The Solana public endpoints are SHARED, RATE-LIMITED infrastructure. They are
# fine for a smoke test, not a guarantee for production monitoring: for a live
# run use an endpoint you are entitled to (and read its rate limits).
# NATIVE_MONITOR_WS_URL=
# NATIVE_MONITOR_ENABLED=true
# NATIVE_MONITOR_STALE_AFTER_MS=8000
# NATIVE_MONITOR_OPEN_TIMEOUT_S=10

# --- PAPER simulation model ----------------------------------------------
# PAPER_START_BANKROLL_USD=100.0
PAPER_ENTRY_FEE_BPS=85
PAPER_EXIT_FEE_BPS=85
PAPER_ENTRY_SLIPPAGE_BPS=120
PAPER_EXIT_SLIPPAGE_BPS=120
PAPER_DECISION_LATENCY_MS=1200

# --- REAL execution (CAPABILITIES ONLY - authorizes nothing) ---------------
# The wallet is a keypair FILE path, never the key material itself. A private
# key in this file makes the config loader REFUSE to start, on purpose.
# WALLET_KEYPAIR_PATH=
# RPC_URL=

REAL_SLIPPAGE_BPS=500
REAL_MAX_PRICE_IMPACT_PCT=5.0
REAL_SIMULATE_BEFORE_SEND=true
REAL_PRIORITY_FEE_LAMPORTS=50000
REAL_CONFIRMATION_TIMEOUT_S=90
REAL_QUOTE_MAX_AGE_MS=8000

# --- Swap build layer: Solana Tracker Raptor (execution infrastructure) -----
# Raptor quotes a route and builds an UNSIGNED transaction. The bot still owns
# sizing, slippage, freshness, simulation, signing, broadcast and
# reconciliation, and never sends it a private key or a signed transaction.
# The hosted endpoint is public / no API key: there is deliberately no
# RAPTOR_API_KEY here. Keep RAPTOR_ENABLED=false until the migration has been
# validated; when false the existing (Jupiter) path is used unchanged.
RAPTOR_ENABLED=false
RAPTOR_BASE_URL=https://raptor.solanatracker.io
# Fall back to Jupiter (unsigned build only) when Raptor cannot construct a
# route. Fallback happens BEFORE simulation/signing/broadcast, so one trade
# intent is still broadcast at most once.
RAPTOR_FALLBACK_ENABLED=true

# Recorded and reported as IGNORED. Arming REAL needs an operator action in
# Telegram plus a passing preflight; this cannot substitute for either.
REAL_TRADING_ENABLED=false
I_UNDERSTAND_REAL_TRADING_RISKS=false

# ===========================================================================
# DO NOT ADD ANY OF THESE. The loader refuses to start if it finds them,
# because key material must live in a permissioned keypair file and not in a
# world-readable environment file:
#   PRIVATE_KEY
#   SOLANA_PRIVATE_KEY
#   SEED_PHRASE
#   MNEMONIC
#
# There is also no re-entry switch. Re-entry is off and has no override.
# ===========================================================================
